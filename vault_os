// CREATE / UNLOCK / LOCK
// ============================================================

bool createMasterPassword(const String& password) {
  if (password.length() < 8 || password.length() > 64) return false;
  uint8_t salt[SALT_SIZE];
  randomBytes(salt, SALT_SIZE);
  if (!deriveKeys(password, salt, encryptionKey, macKey)) return false;
  memset(&vault, 0, sizeof(vault));
  vault.magic = VAULT_MAGIC;
  vault.version = VAULT_VERSION;
  vault.count = 0;
  if (!saveVaultWithSalt(salt)) {
    memset(encryptionKey, 0, sizeof(encryptionKey));
    memset(macKey, 0, sizeof(macKey));
    memset(salt, 0, sizeof(salt));
    return false;
  }
  memcpy(activeSalt, salt, SALT_SIZE);
  memset(salt, 0, sizeof(salt));
  vaultUnlocked = true;
  lastActivity = millis();
  return true;
}

bool unlockVault(const char* pw, size_t pwLen) {
  VaultData tempVault;
  uint8_t salt[SALT_SIZE];
  uint8_t aes[AES_KEY_SIZE];
  uint8_t mac[MAC_KEY_SIZE];
  memset(&tempVault, 0, sizeof(tempVault));

  if (!loadVaultWithPassword(pw, pwLen, salt, aes, mac, &tempVault)) {
    memset(salt, 0, sizeof(salt));
    memset(aes, 0, sizeof(aes));
    memset(mac, 0, sizeof(mac));
    return false;
  }
  memcpy(&vault, &tempVault, sizeof(vault));
  memcpy(activeSalt, salt, SALT_SIZE);
  memcpy(encryptionKey, aes, AES_KEY_SIZE);
  memcpy(macKey, mac, MAC_KEY_SIZE);

  memset(&tempVault, 0, sizeof(tempVault));
  memset(salt, 0, sizeof(salt));
  memset(aes, 0, sizeof(aes));
  memset(mac, 0, sizeof(mac));

  vaultUnlocked = true;
  lastActivity = millis();
  return true;
}

void lockVault() {
  vaultUnlocked = false;
  webToken = "";
  memset(encryptionKey, 0, sizeof(encryptionKey));
  memset(macKey, 0, sizeof(macKey));
  memset(activeSalt, 0, sizeof(activeSalt));
  memset(&vault, 0, sizeof(vault));
  memset(editorBuffer, 0, sizeof(editorBuffer));
  editorLen = 0;
  editorCursor = 0;
  selectedRecord = 0;
  menuIndex = 0;
  currentScreen = SCREEN_LOCKED;
}

UnlockResult attemptUnlock(const char* pw, size_t pwLen) {
  UnlockResult r;
  r.ok = false;
  r.waitSeconds = 0;
  unsigned long now = millis();

  if (now < lockoutUntil) {
    r.waitSeconds = (lockoutUntil - now + 999) / 1000;
    return r;
  }
  if (unlockVault(pw, pwLen)) {
    failedAttempts = 0;
    lockoutUntil = 0;
    r.ok = true;
    return r;
  }
  if (failedAttempts < 8) failedAttempts++;
  const unsigned long delays[] = {0,1,2,4,8,15,30,60,120};
  unsigned long delaySec = delays[failedAttempts];
  lockoutUntil = now + delaySec * 1000UL;
  r.waitSeconds = delaySec;
  return r;
}

UnlockResult attemptUnlock(const String& pw) {
  return attemptUnlock(pw.c_str(), pw.length());
}

// ============================================================
// PASSWORD GENERATOR
// ============================================================

void generatePassword(char* out, int length,
                      bool upper, bool lower,
                      bool numbers, bool symbols) {
  char chars[128];
  int n = 0;
  if (upper)   for (const char* p = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"; *p; p++) chars[n++] = *p;
  if (lower)   for (const char* p = "abcdefghijklmnopqrstuvwxyz"; *p; p++) chars[n++] = *p;
  if (numbers) for (const char* p = "0123456789"; *p; p++) chars[n++] = *p;
  if (symbols) for (const char* p = "!@#$%^&*()-_=+[]{}"; *p; p++) chars[n++] = *p;
  if (n == 0)  for (const char* p = "abcdefghijklmnopqrstuvwxyz"; *p; p++) chars[n++] = *p;
  chars[n] = 0;

  if (length > MAX_PASS) length = MAX_PASS;
  for (int i = 0; i < length; i++)
    out[i] = chars[secureRandom() % n];
  out[length] = 0;
}

void applyGeneratorMode(bool &up, bool &lo, bool &nu, bool &sy) {
  switch (generatorMode) {
    case 0: up = true;  lo = true;  nu = true;  sy = true;  break;
    case 1: up = true;  lo = true;  nu = true;  sy = false; break;
    case 2: up = true;  lo = true;  nu = true;  sy = false; break;
    case 3: up = true;  lo = true;  nu = false; sy = true;  break;
  }
}

void newGeneratedPassword() {
  bool up, lo, nu, sy;
  applyGeneratorMode(up, lo, nu, sy);
  generatePassword(generatedPassword, generatorLength, up, lo, nu, sy);
}

// ============================================================
// HTML ESCAPE
// ============================================================

String htmlEscape(const String &in) {
  String out;
  out.reserve(in.length() + 16);
  for (size_t i = 0; i < in.length(); i++) {
    switch (in[i]) {
      case '&': out += "&amp;"; break;
      case '<': out += "&lt;"; break;
      case '>': out += "&gt;"; break;
      case '"': out += "&quot;"; break;
      case '\'': out += "&#39;"; break;
      default: out += in[i];
    }
  }
  return out;
}

// ============================================================
// WEB SESSION
// ============================================================

bool getCookieToken(String &token) {
  if (!server.hasHeader("Cookie")) return false;
  String cookie = server.header("Cookie");
  int pos = cookie.indexOf("session=");
  if (pos < 0) return false;
  token = cookie.substring(pos + 8);
  int semi = token.indexOf(';');
  if (semi >= 0) token = token.substring(0, semi);
  token.trim();
  return token.length() > 0;
}

bool checkSession() {
  if (!vaultUnlocked || webToken.length() == 0) return false;
  String token;
  if (!getCookieToken(token)) return false;
  return constantTimeEquals(token, webToken);
}

void setSessionCookie() {
  server.sendHeader("Set-Cookie",
    "session=" + webToken + "; Path=/; HttpOnly; SameSite=Strict");
}

void clearSessionCookie() {
  server.sendHeader("Set-Cookie", "session=deleted; Path=/; Max-Age=0");
}

void redirectTo(const String &path) {
  server.sendHeader("Location", path);
  server.send(303);
}

bool requireAuth() {
  if (!checkSession()) { redirectTo("/"); return false; }
  lastActivity = millis();
  return true;
}

bool checkCSRF() {
  if (!constantTimeEquals(server.arg("csrf"), webToken)) {
    server.send(403, "text/plain", "Invalid CSRF token");
    return false;
  }
  return true;
}

