// Returns current cell char, or 0 if action row
char kbdCurrentChar() {
  if (kbdRow < 3) {
    const char* row = KBD_ROWS[kbdLayout][kbdRow];
    int len = strlen(row);
    if (kbdCol >= len) kbdCol = len - 1;
    if (kbdCol < 0) kbdCol = 0;
    return row[kbdCol];
  }
  return 0;
}

void kbdClampCursor() {
  if (kbdRow < 3) {
    int len = strlen(KBD_ROWS[kbdLayout][kbdRow]);
    if (kbdCol >= len) kbdCol = len - 1;
  } else {
    if (kbdCol > 5) kbdCol = 5;
  }
  if (kbdCol < 0) kbdCol = 0;
  if (kbdRow < 0) kbdRow = 0;
  if (kbdRow > 3) kbdRow = 3;
}

void editorInsertChar(char c) {
  if (editorLen >= MAX_EDITOR) return;
  if (editorCursor < 0) editorCursor = 0;
  if (editorCursor > editorLen) editorCursor = editorLen;
  for (int i = editorLen; i > editorCursor; i--)
    editorBuffer[i] = editorBuffer[i - 1];
  editorBuffer[editorCursor] = c;
  editorLen++;
  editorCursor++;
  editorBuffer[editorLen] = 0;
}

void editorDeleteChar() {
  if (editorLen == 0 || editorCursor <= 0) return;
  for (int i = editorCursor - 1; i < editorLen - 1; i++)
    editorBuffer[i] = editorBuffer[i + 1];
  editorLen--;
  editorCursor--;
  editorBuffer[editorLen] = 0;
}

const char* editorTitle() {
  switch (editorTarget) {
    case EDIT_MASTER:         return "MASTER";
    case EDIT_MASTER_CONFIRM: return "CONFIRM";
    case EDIT_NAME:           return "SERVICE";
    case EDIT_USERNAME:       return "USERNAME";
    case EDIT_PASSWORD:       return "PASSWORD";
    case EDIT_NOTE:           return "NOTE";
    case EDIT_TOTP:           return "TOTP";
    case EDIT_SEARCH:         return "SEARCH";
    default:                  return "EDIT";
  }
}

bool editorIsHidden() {
  return editorTarget == EDIT_MASTER ||
         editorTarget == EDIT_MASTER_CONFIRM ||
         editorTarget == EDIT_PASSWORD;
}

void showEditor() {
  oled.clearBuffer();

  // Header
  oled.setFont(u8g2_font_5x7_tf);
  oled.drawStr(0, 8, editorTitle());
  oled.drawHLine(0, 10, 128);

  // Text line (20 chars, scroll to cursor)
  int viewStart = 0;
  const int VIEW = 20;
  if (editorCursor > VIEW - 1) viewStart = editorCursor - VIEW + 1;
  if (viewStart < 0) viewStart = 0;

  char line[24];
  int n = 0;
  bool hide = editorIsHidden();
  for (int i = viewStart; i < editorLen && n < VIEW; i++) {
    line[n++] = hide ? '*' : editorBuffer[i];
  }
  line[n] = 0;
  oled.drawStr(0, 19, line);

  // Cursor position
  int curView = editorCursor - viewStart;
  if (curView < 0) curView = 0;
  int curX = curView * 6;
  if (curX > 122) curX = 122;
  oled.drawBox(curX, 20, 6, 1);

  // Keyboard rows
  oled.setFont(u8g2_font_5x7_tf);
  const int CELL_W = 12;
  const int ROW_H = 10;

  for (int r = 0; r < 3; r++) {
    const char* row = KBD_ROWS[kbdLayout][r];
    int y = 24 + r * ROW_H;
    for (int c = 0; c < 10; c++) {
      int x = c * CELL_W;
      bool sel = (kbdRow == r && kbdCol == c);

      if (sel) {
        oled.drawBox(x, y, CELL_W, ROW_H - 1);
        oled.setDrawColor(0);
      }
      char buf[2] = { row[c] ? row[c] : ' ', 0 };
      oled.drawStr(x + 3, y + 7, buf);
      oled.setDrawColor(1);
    }
  }

  // Action row
  int ay = 24 + 3 * ROW_H;
  // 6 buttons: abc, ABC, 123, #@!, <x, OK
  int ax_w = 21;  // 6*21 = 126
  for (int i = 0; i < 6; i++) {
    int x = i * ax_w;
    bool sel = (kbdRow == 3 && kbdCol == i);
    // highlight active layout
    bool activeLayout = (i < 4 && i == kbdLayout);

    if (sel) {
      oled.drawBox(x, ay, ax_w - 1, ROW_H - 1);
      oled.setDrawColor(0);
    } else if (activeLayout) {
      oled.drawFrame(x, ay, ax_w - 1, ROW_H - 1);
    }
    oled.setFont(u8g2_font_5x7_tf);
    oled.drawStr(x + 3, ay + 7, KBD_ACTION_LABELS[i]);
    oled.setDrawColor(1);
  }

  oled.sendBuffer();
}

// ============================================================
// EDITOR: RESET / APPLY
// ============================================================

void resetEditor(EditTarget target, const char* initial = "") {
  memset(editorBuffer, 0, sizeof(editorBuffer));
  editorLen = 0;
  editorCursor = 0;
  editorTarget = target;
  kbdLayout = 0;
  kbdRow = 0;
  kbdCol = 0;

  if (initial && *initial) {
    strlcpy(editorBuffer, initial, sizeof(editorBuffer));
    editorLen = strlen(editorBuffer);
    editorCursor = editorLen;
  }
}

// ============================================================
// ADD / EDIT FLOW
// ============================================================

void beginAdd() {
  editRecordIndex = -1;
  editField = 0;
  resetEditor(EDIT_NAME);
  currentScreen = SCREEN_ADD;
}

void beginEdit(int index) {
  if (index < 0 || index >= vault.count) return;
  editRecordIndex = index;
  editField = 0;
  resetEditor(EDIT_NAME, vault.records[index].name);
  currentScreen = SCREEN_EDIT;
}

void loadFieldIntoEditor(int field) {
  VaultRecord *r = (editRecordIndex >= 0) ? &vault.records[editRecordIndex] : nullptr;
  switch (field) {
    case 0: resetEditor(EDIT_NAME,     r ? r->name     : ""); break;
    case 1: resetEditor(EDIT_USERNAME, r ? r->username : ""); break;
    case 2: resetEditor(EDIT_PASSWORD, r ? r->password : ""); break;
    case 3: resetEditor(EDIT_TOTP,     r ? r->totp     : ""); break;
    case 4: resetEditor(EDIT_NOTE,     r ? r->note     : ""); break;
  }
}

void addOrEditNextField() {
  // Save current field into record
  VaultRecord &r = vault.records[(editRecordIndex >= 0) ? editRecordIndex : vault.count];
  if (editRecordIndex < 0 && editField == 0) {
    memset(&vault.records[vault.count], 0, sizeof(VaultRecord));
    vault.records[vault.count].type = RECORD_PASSWORD;
  }

  switch (editField) {
    case 0: strlcpy(r.name,     editorBuffer, MAX_NAME); break;
    case 1: strlcpy(r.username, editorBuffer, MAX_USER); break;
    case 2: strlcpy(r.password, editorBuffer, MAX_PASS); break;
    case 3: strlcpy(r.totp,     editorBuffer, MAX_TOTP); break;
    case 4: strlcpy(r.note,     editorBuffer, MAX_NOTE); break;
  }

  editField++;

  if (editField >= 5) {
    if (editRecordIndex < 0) {
      vault.count++;
      if (!saveCurrentVault()) {
        vault.count--;
        return;
      }
    } else {
      if (!saveCurrentVault()) return;
    }
    currentScreen = SCREEN_HOME;
    return;
  }
  loadFieldIntoEditor(editField);
}

