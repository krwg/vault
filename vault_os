  if (!restoreVaultFromFile(backupPassword)) {
    LittleFS.remove("/restore.tmp");
    server.send(400, "text/plain", "Invalid backup or password"); return;
  }
  webToken = randomHexToken(SESSION_BYTES);
  setSessionCookie();
  redirectTo("/");
}

