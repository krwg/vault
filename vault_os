// ============================================================
// EDITOR BUTTON HANDLING
// ============================================================

void handleEditorButtons(ButtonEvent up, ButtonEvent down,
                         ButtonEvent enter, ButtonEvent back) {
  const char* set = CHARSET_GROUPS[editorCharset];
  int setLen = strlen(set);

  // Character wheel: R5=prev, R6=next
  if (up == BTN_SHORT)
    editorCharIndex = (editorCharIndex - 1 + setLen) % setLen;
  if (down == BTN_SHORT)
    editorCharIndex = (editorCharIndex + 1) % setLen;

  // Charset switch: long press
  if (up == BTN_LONG) {
    editorCharset = (editorCharset - 1 + 4) % 4;
    editorCharIndex = 0;
  }
  if (down == BTN_LONG) {
    editorCharset = (editorCharset + 1) % 4;
    editorCharIndex = 0;
  }

  // Insert char: R7 short
  if (enter == BTN_SHORT)
    editorInsertChar(CHARSET_GROUPS[editorCharset][editorCharIndex]);

  // Delete char: R8 short
  if (back == BTN_SHORT)
    editorDeleteChar();

  // R7 long = accept (handled by caller)
  // R8 long = cancel (handled by caller)
}

// ============================================================
// BUTTON MAIN
// ============================================================

void handleButtons() {
  ButtonEvent up    = pollButton(PIN_R5, bR5);
  ButtonEvent down  = pollButton(PIN_R6, bR6);
  ButtonEvent enter = pollButton(PIN_R7, bR7);
  ButtonEvent back  = pollButton(PIN_R8, bR8);

  if (up == BTN_NONE && down == BTN_NONE &&
      enter == BTN_NONE && back == BTN_NONE) return;

  lastActivity = millis();

  // ---------------- LOCKED ----------------
  if (currentScreen == SCREEN_LOCKED) {
    if (enter == BTN_SHORT && millis() >= lockoutUntil) {
      resetEditor(EDIT_MASTER);
      currentScreen = SCREEN_UNLOCK;
    }
    return;
  }

  // ---------------- UNLOCK ----------------
  if (currentScreen == SCREEN_UNLOCK) {
    handleEditorButtons(up, down, enter, back);
    if (enter == BTN_LONG) {
      UnlockResult r = attemptUnlock(editorBuffer, editorLen);
      memset(editorBuffer, 0, sizeof(editorBuffer));
      editorLen = 0;
      editorCursor = 0;
      if (r.ok) {
        currentScreen = SCREEN_HOME;
        menuIndex = 0;
      } else {
        currentScreen = SCREEN_LOCKED;
      }
    }
    if (back == BTN_LONG) {
      memset(editorBuffer, 0, sizeof(editorBuffer));
      editorLen = 0; editorCursor = 0;
      currentScreen = SCREEN_LOCKED;
    }
    return;
  }

  // ---------------- ADD / EDIT ----------------
  if (currentScreen == SCREEN_ADD || currentScreen == SCREEN_EDIT) {
    handleEditorButtons(up, down, enter, back);
    if (enter == BTN_LONG) addOrEditNextField();
    if (back == BTN_LONG) {
      memset(editorBuffer, 0, sizeof(editorBuffer));
      editorLen = 0; editorCursor = 0;
      currentScreen = SCREEN_HOME;
    }
    return;
  }

  // ---------------- SEARCH ----------------
  if (currentScreen == SCREEN_SEARCH) {
    handleEditorButtons(up, down, enter, back);
    if (enter == BTN_LONG) {
      memset(searchBuffer, 0, sizeof(searchBuffer));
      memcpy(searchBuffer, editorBuffer, editorLen);
      searchBuffer[editorLen] = 0;
      buildSearchResults();
      currentScreen = SCREEN_LIST;
    }
    if (back == BTN_LONG) {
      currentScreen = SCREEN_HOME;
    }
    return;
  }

  // ---------------- CHANGE MASTER ----------------
  if (currentScreen == SCREEN_CHANGE_MASTER) {
    handleEditorButtons(up, down, enter, back);
    if (enter == BTN_LONG) handleChangeMasterEnter();
    if (back == BTN_LONG) {
      memset(confirmMasterBuffer, 0, sizeof(confirmMasterBuffer));
      resetEditor(EDIT_NONE);
      currentScreen = SCREEN_SETTINGS;
    }
    return;
  }

  // ---------------- HOME ----------------
  if (currentScreen == SCREEN_HOME) {
    if (up == BTN_SHORT) { if (menuIndex > 0) menuIndex--; }
    else if (down == BTN_SHORT) { if (menuIndex < 5) menuIndex++; }
    else if (enter == BTN_SHORT) {
      switch (menuIndex) {
        case 0: searchCount = 0; selectedRecord = 0;
                currentScreen = SCREEN_LIST; break;
        case 1: resetEditor(EDIT_SEARCH); currentScreen = SCREEN_SEARCH; break;
        case 2: if (vault.count < MAX_RECORDS) beginAdd(); break;
        case 3: generatorLength = 24; generatorMode = 0;
                newGeneratedPassword(); currentScreen = SCREEN_GENERATOR; break;
        case 4: menuIndex = 0; currentScreen = SCREEN_SETTINGS; break;
        case 5: lockVault(); break;
      }
    }
    return;
  }

  // ---------------- LIST ----------------
  if (currentScreen == SCREEN_LIST) {
    int count = searchCount ? searchCount : vault.count;
    if (up == BTN_SHORT && selectedRecord > 0) selectedRecord--;
    else if (down == BTN_SHORT && selectedRecord < count - 1) selectedRecord++;
    else if (enter == BTN_SHORT && count > 0) {
      if (searchCount) selectedRecord = searchResults[selectedRecord];
      recordPasswordVisible = false;
      currentScreen = SCREEN_RECORD;
    } else if (back == BTN_SHORT) {
      currentScreen = SCREEN_HOME;
    }
    return;
  }

  // ---------------- RECORD ----------------
  if (currentScreen == SCREEN_RECORD) {
    if (enter == BTN_SHORT) recordPasswordVisible = !recordPasswordVisible;
    else if (enter == BTN_LONG) beginEdit(selectedRecord);
    else if (back == BTN_SHORT) currentScreen = SCREEN_LIST;
    return;
  }

  // ---------------- GENERATOR ----------------
  if (currentScreen == SCREEN_GENERATOR) {
    if (up == BTN_SHORT && generatorLength < 95) generatorLength++;
    else if (down == BTN_SHORT && generatorLength > 8) generatorLength--;
    else if (enter == BTN_SHORT) newGeneratedPassword();
    else if (enter == BTN_LONG) {
      generatorMode = (generatorMode + 1) % 4;
      newGeneratedPassword();
    } else if (back == BTN_SHORT) currentScreen = SCREEN_HOME;
    return;
  }

  // ---------------- SETTINGS ----------------
  if (currentScreen == SCREEN_SETTINGS) {
    if (up == BTN_SHORT && menuIndex > 0) menuIndex--;
    else if (down == BTN_SHORT && menuIndex < 2) menuIndex++;
    else if (enter == BTN_SHORT) {
      switch (menuIndex) {
        case 0: startChangeMaster(); break;
        case 1:
          if (config.autoLockSeconds == 60) config.autoLockSeconds = 120;
          else if (config.autoLockSeconds == 120) config.autoLockSeconds = 300;
          else config.autoLockSeconds = 60;
          saveConfig();
          break;
        case 2: lockVault(); break;
      }
    } else if (back == BTN_SHORT) {
      currentScreen = SCREEN_HOME;
    }
    return;
  }
}

// ============================================================
// SETUP
// ============================================================

void setup() {
  Serial.begin(115200);
  delay(400);
  Serial.println();
  Serial.println("======================");
  Serial.println("VAULT OS 0.7");
  Serial.println("======================");

  Wire.begin(PIN_SDA, PIN_SCL);
  oled.begin();
  oled.clearBuffer();
  oled.sendBuffer();

  pinMode(PIN_R5, INPUT_PULLUP);
  pinMode(PIN_R6, INPUT_PULLUP);
  pinMode(PIN_R7, INPUT_PULLUP);
  pinMode(PIN_R8, INPUT_PULLUP);

  showBoot();

  if (!LittleFS.begin(true)) {
    oled.clearBuffer();
    oled.setFont(u8g2_font_6x10_tf);
    oled.drawStr(5, 32, "FILESYSTEM ERROR");
    oled.sendBuffer();
    while (true) delay(1000);
  }
  Serial.println("[FS] OK");

  if (!loadConfig()) {
    memset(&config, 0, sizeof(config));
    config.magic = CONFIG_MAGIC;
    config.version = CONFIG_VERSION;
    config.autoLockSeconds = AUTO_LOCK_DEFAULT;
    String ap = generateApPassword();
    strlcpy(config.apPassword, ap.c_str(), sizeof(config.apPassword));
    if (!saveConfig()) Serial.println("[CONFIG] save failed");
  } else {
    Serial.println("[CONFIG] loaded");
  }

  startWiFi();
  startWebServer();

  if (LittleFS.exists(VAULT_FILE)) {
    currentScreen = SCREEN_LOCKED;
    showLocked();
  } else {
    currentScreen = SCREEN_SETUP;
    showSetup();
  }
}

// ============================================================
// LOOP
// ============================================================

void loop() {
  server.handleClient();

  if (vaultUnlocked && config.autoLockSeconds > 0 &&
      millis() - lastActivity > config.autoLockSeconds * 1000UL) {
    Serial.println("[VAULT] Auto-lock");
    lockVault();
  }

  handleButtons();

  switch (currentScreen) {
    case SCREEN_SETUP:         showSetup();         break;
    case SCREEN_LOCKED:        showLocked();        break;
    case SCREEN_UNLOCK:        showEditor();        break;
    case SCREEN_HOME:          showHome();          break;
    case SCREEN_LIST:          showList();          break;
    case SCREEN_RECORD:        showRecord();        break;
    case SCREEN_ADD:
    case SCREEN_EDIT:
    case SCREEN_SEARCH:
    case SCREEN_CHANGE_MASTER: showEditor();        break;
    case SCREEN_GENERATOR:     showGenerator();     break;
    case SCREEN_SETTINGS:      showSettings();      break;
    default: break;
  }

  delay(20);
}
