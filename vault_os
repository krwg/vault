void handleChangeMasterEnter() {
  if (editorTarget == EDIT_MASTER) {
    memcpy(confirmMasterBuffer, editorBuffer, editorLen);
    confirmMasterBuffer[editorLen] = 0;
    resetEditor(EDIT_MASTER_CONFIRM);
    return;
  }
  if (editorTarget == EDIT_MASTER_CONFIRM) {
    if (strcmp(confirmMasterBuffer, editorBuffer) != 0) {
      memset(confirmMasterBuffer, 0, sizeof(confirmMasterBuffer));
      resetEditor(EDIT_MASTER);
      return;
    }
    if (!changeMasterPassword(confirmMasterBuffer, strlen(confirmMasterBuffer))) {
      memset(confirmMasterBuffer, 0, sizeof(confirmMasterBuffer));
      resetEditor(EDIT_MASTER);
      return;
    }
    memset(confirmMasterBuffer, 0, sizeof(confirmMasterBuffer));
    resetEditor(EDIT_NONE);
    currentScreen = SCREEN_SETTINGS;
  }
}

