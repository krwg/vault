    server.send(404, "application/json", "{}"); return;
  }
  VaultRecord &r = vault.records[id];
  char code[8] = "------";
  if (strlen(r.totp)) {
    time_t now = time(nullptr);
    if (now > 1600000000) {
      uint32_t t = (uint32_t)(now / 30);
      if (!totpGenerate(r.totp, t, code)) strlcpy(code, "------", sizeof(code));
    }
  }
  String j = "{\"code\":\"";
  j += code;
  j += "\"}";
  server.send(200, "application/json", j);
}

