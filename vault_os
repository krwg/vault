  memset(&r, 0, sizeof(r));
  r.type = RECORD_PASSWORD;
  strlcpy(r.name, name.c_str(), MAX_NAME);
  strlcpy(r.username, server.arg("username").c_str(), MAX_USER);
  strlcpy(r.password, server.arg("password").c_str(), MAX_PASS);
  strlcpy(r.note, server.arg("note").c_str(), MAX_NOTE);
  strlcpy(r.totp, server.arg("totp").c_str(), MAX_TOTP);

  if (!saveCurrentVault()) {
    memcpy(&r, &backup, sizeof(r));
    server.send(500, "text/plain", "Vault write failed");
    return;
  }
  memset(&backup, 0, sizeof(backup));
  redirectTo("/view?id=" + String(id));
