// ============================================================

void beginAdd() {
  editRecordIndex = -1;
  editField = 0;
  resetEditor(EDIT_NAME);
  currentScreen = SCREEN_ADD;
}

void beginEdit(int index) {
  if (index < 0 || index >= vault.count) return;
  editRecordIndex = index;
  editField = 0;
  resetEditor(EDIT_NAME);
  strlcpy(editorBuffer, vault.records[index].name, sizeof(editorBuffer));
  editorLen = strlen(editorBuffer);
  editorCursor = editorLen;
  currentScreen = SCREEN_EDIT;
}

void addOrEditNextField() {
  if (editRecordIndex >= 0) {
    VaultRecord &r = vault.records[editRecordIndex];
    switch (editField) {
      case 0: strlcpy(r.name,     editorBuffer, MAX_NAME); break;
      case 1: strlcpy(r.username, editorBuffer, MAX_USER); break;
      case 2: strlcpy(r.password, editorBuffer, MAX_PASS); break;
      case 3: strlcpy(r.note,     editorBuffer, MAX_NOTE); break;
    }
  } else {
    if (editField == 0) {
      memset(&vault.records[vault.count], 0, sizeof(VaultRecord));
      vault.records[vault.count].type = RECORD_PASSWORD;
      strlcpy(vault.records[vault.count].name, editorBuffer, MAX_NAME);
    } else {
      VaultRecord &r = vault.records[vault.count];
      switch (editField) {
        case 1: strlcpy(r.username, editorBuffer, MAX_USER); break;
        case 2: strlcpy(r.password, editorBuffer, MAX_PASS); break;
        case 3: strlcpy(r.note,     editorBuffer, MAX_NOTE); break;
      }
    }
  }

  editField++;
  if (editField >= 4) {
    if (editRecordIndex < 0) {
      vault.count++;
      if (!saveCurrentVault()) { vault.count--; return; }
    } else {
      if (!saveCurrentVault()) return;
    }
    currentScreen = SCREEN_HOME;
    return;
  }

  switch (editField) {
    case 0:
      resetEditor(EDIT_NAME);
      if (editRecordIndex >= 0)
        strlcpy(editorBuffer, vault.records[editRecordIndex].name, sizeof(editorBuffer));
      break;
    case 1:
      resetEditor(EDIT_USERNAME);
      if (editRecordIndex >= 0)
        strlcpy(editorBuffer, vault.records[editRecordIndex].username, sizeof(editorBuffer));
      break;
    case 2:
      resetEditor(EDIT_PASSWORD);
      if (editRecordIndex >= 0)
        strlcpy(editorBuffer, vault.records[editRecordIndex].password, sizeof(editorBuffer));
      break;
    case 3:
      resetEditor(EDIT_NOTE);
      if (editRecordIndex >= 0)
        strlcpy(editorBuffer, vault.records[editRecordIndex].note, sizeof(editorBuffer));
      break;
  }
  editorLen = strlen(editorBuffer);
  editorCursor = editorLen;
}

