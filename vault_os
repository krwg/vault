// ============================================================

void resetEditor(EditTarget target) {
  memset(editorBuffer, 0, sizeof(editorBuffer));
  editorLen = 0;
  editorCursor = 0;
  editorCharset = 0;
  editorCharIndex = 0;
  editorTarget = target;
}

void editorInsertChar(char c) {
  if (editorLen >= MAX_EDITOR) return;
  if (editorCursor < 0) editorCursor = 0;
  if (editorCursor > editorLen) editorCursor = editorLen;
  for (int i = editorLen; i > editorCursor; i--)
    editorBuffer[i] = editorBuffer[i - 1];
  editorBuffer[editorCursor] = c;
  editorLen++;
  editorCursor++;
  editorBuffer[editorLen] = 0;
}

void editorDeleteChar() {
  if (editorLen == 0) return;
  if (editorCursor <= 0) return;
  for (int i = editorCursor - 1; i < editorLen - 1; i++)
    editorBuffer[i] = editorBuffer[i + 1];
  editorLen--;
  editorCursor--;
  editorBuffer[editorLen] = 0;
}

void editorDraw(const char* title, bool hide) {
  oled.clearBuffer();
  header(title);
  oled.setFont(u8g2_font_6x10_tf);

  // Show up to 20 chars, scrolled so cursor is visible.
  int viewStart = 0;
  const int VIEW = 20;
  if (editorCursor > VIEW - 1) viewStart = editorCursor - VIEW + 1;

  char line[24];
  int n = 0;
  for (int i = viewStart; i < editorLen && n < VIEW; i++) {
    line[n++] = hide ? '*' : editorBuffer[i];
  }
  line[n] = 0;
  oled.drawStr(2, 25, line);
  oled.drawHLine(0, 28, 128);

  // Cursor indicator: position of cursor inside view
  int curView = editorCursor - viewStart;
  int curX = 2 + curView * 6;
  if (curX < 0) curX = 0;
  if (curX > 126) curX = 126;
  oled.drawBox(curX, 29, 6, 2);

  // Current char being edited
  oled.setFont(u8g2_font_7x14B_tf);
  char c[2];
  c[0] = CHARSET_GROUPS[editorCharset][editorCharIndex];
  c[1] = 0;
  oled.drawStr(4, 47, c);

  oled.setFont(u8g2_font_6x10_tf);
  char setLine[24];
  snprintf(setLine, sizeof(setLine), "set: %s", CHARSET_LABELS[editorCharset]);
  oled.drawStr(28, 46, setLine);

  oled.drawStr(2, 57, "R5/R6 char  R7 add");
  oled.drawStr(2, 63, "holdR7 next R8 del");

  oled.sendBuffer();
}

void showEditor() {
