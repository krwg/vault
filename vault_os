File restoreUpload;
bool restoreUploadStarted = false;

void handleRestoreUpload() {
  HTTPUpload& upload = server.upload();
  if (upload.status == UPLOAD_FILE_START) {
    restoreUploadStarted = true;
    LittleFS.remove("/restore.tmp");
    restoreUpload = LittleFS.open("/restore.tmp", FILE_WRITE);
  } else if (upload.status == UPLOAD_FILE_WRITE) {
    if (restoreUpload) restoreUpload.write(upload.buf, upload.currentSize);
  } else if (upload.status == UPLOAD_FILE_END) {
    if (restoreUpload) { restoreUpload.flush(); restoreUpload.close(); }
    restoreUploadStarted = false;
  }
}

bool restoreVaultFromFile(const String& password) {
  File f = LittleFS.open("/restore.tmp", FILE_READ);
  if (!f) return false;
  VaultHeader header;
  if (f.read((uint8_t*)&header, sizeof(header)) != sizeof(header)) { f.close(); return false; }
  if (header.magic != VAULT_MAGIC || header.version != VAULT_VERSION ||
      header.dataLen == 0 || header.dataLen > 65536 || header.dataLen % 16) {
    f.close(); return false;
  }
  size_t totalSize = sizeof(VaultHeader) + header.dataLen + MAC_SIZE;
  if (f.size() != totalSize) { f.close(); return false; }

  uint8_t* encrypted = (uint8_t*)malloc(header.dataLen);
  if (!encrypted) { f.close(); return false; }
  if (f.read(encrypted, header.dataLen) != header.dataLen) {
    free(encrypted); f.close(); return false;
  }
  uint8_t storedMac[MAC_SIZE];
  if (f.read(storedMac, MAC_SIZE) != MAC_SIZE) {
    free(encrypted); f.close(); return false;
  }
  f.close();

  uint8_t newAES[AES_KEY_SIZE], newMAC[MAC_KEY_SIZE];
  if (!deriveKeys(password, header.salt, newAES, newMAC)) {
    free(encrypted); return false;
  }

  uint8_t savedMacKey[MAC_KEY_SIZE];
  memcpy(savedMacKey, macKey, MAC_KEY_SIZE);
  memcpy(macKey, newMAC, MAC_KEY_SIZE);

  uint8_t calculatedMac[MAC_SIZE];
  bool macOk = calculateVaultMac(header, encrypted, header.dataLen, calculatedMac);
  if (!macOk || !constantTimeEquals(storedMac, calculatedMac, MAC_SIZE)) {
    memcpy(macKey, savedMacKey, MAC_KEY_SIZE);
    memset(savedMacKey, 0, sizeof(savedMacKey));
    free(encrypted); return false;
  }
  memcpy(encryptionKey, newAES, AES_KEY_SIZE);
  memcpy(macKey, newMAC, MAC_KEY_SIZE);
  memset(savedMacKey, 0, sizeof(savedMacKey));

  uint8_t* plain = (uint8_t*)malloc(header.dataLen);
  if (!plain) { free(encrypted); return false; }
  if (!aesDecrypt(encrypted, plain, header.dataLen, encryptionKey, header.iv)) {
    memset(plain, 0, header.dataLen);
    free(encrypted); free(plain); return false;
  }
  size_t plainLen = header.dataLen;
  if (!removePadding(plain, plainLen) || plainLen != sizeof(VaultData)) {
    memset(plain, 0, header.dataLen);
    free(encrypted); free(plain); return false;
  }
  VaultData imported;
  memcpy(&imported, plain, sizeof(imported));
  if (imported.magic != VAULT_MAGIC || imported.version != VAULT_VERSION ||
      imported.count > MAX_RECORDS) {
    memset(&imported, 0, sizeof(imported));
    memset(plain, 0, header.dataLen);
    free(encrypted); free(plain); return false;
  }

  LittleFS.remove("/restore.valid");
  File out = LittleFS.open("/restore.valid", FILE_WRITE);
  if (!out) {
    memset(plain, 0, header.dataLen);
    free(encrypted); free(plain); return false;
  }
  out.write((uint8_t*)&header, sizeof(header));
  out.write(encrypted, header.dataLen);
  out.write(storedMac, MAC_SIZE);
  out.flush(); out.close();

  LittleFS.remove(VAULT_FILE);
  if (!LittleFS.rename("/restore.valid", VAULT_FILE)) return false;

  memcpy(&vault, &imported, sizeof(vault));
  memcpy(activeSalt, header.salt, SALT_SIZE);

  memset(&imported, 0, sizeof(imported));
  memset(newAES, 0, sizeof(newAES));
  memset(newMAC, 0, sizeof(newMAC));
  memset(plain, 0, header.dataLen);
  free(encrypted); free(plain);
  LittleFS.remove("/restore.tmp");
  return true;
}

void webRestorePost() {
  if (!requireAuth()) return;
  if (!checkCSRF()) return;
  String backupPassword = server.arg("backupPassword");
  if (!restoreUploadStarted && !LittleFS.exists("/restore.tmp")) {
    server.send(400, "text/plain", "No backup uploaded"); return;
  }
  if (!restoreVaultFromFile(backupPassword)) {
    LittleFS.remove("/restore.tmp");
    server.send(400, "text/plain", "Invalid backup or password"); return;
  }
  webToken = randomHexToken(SESSION_BYTES);
  setSessionCookie();
  redirectTo("/");
}

