void webDeletePost() {
  if (!requireAuth()) return;
  if (!checkCSRF()) return;
  int id = server.arg("id").toInt();
  if (id < 0 || id >= vault.count) { server.send(404, "text/plain", "Not found"); return; }

  VaultData backup = vault;
  for (int i = id; i < vault.count - 1; i++)
    memcpy(&vault.records[i], &vault.records[i + 1], sizeof(VaultRecord));
  memset(&vault.records[vault.count - 1], 0, sizeof(VaultRecord));
  vault.count--;

  if (!saveCurrentVault()) {
    memcpy(&vault, &backup, sizeof(vault));
    memset(&backup, 0, sizeof(backup));
    server.send(500, "text/plain", "Vault write failed");
    return;
  }
  memset(&backup, 0, sizeof(backup));
  redirectTo("/");
}

