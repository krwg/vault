// ============================================================
// CHANGE MASTER
// ============================================================

bool changeMasterPassword(const char* pw, size_t pwLen) {
  if (pwLen < 8 || pwLen > 64) return false;

  uint8_t newSalt[SALT_SIZE];
  uint8_t newAES[AES_KEY_SIZE];
  uint8_t newMAC[MAC_KEY_SIZE];
  randomBytes(newSalt, SALT_SIZE);

  if (!deriveKeys(pw, pwLen, newSalt, newAES, newMAC)) {
    memset(newSalt, 0, sizeof(newSalt));
    return false;
  }

  uint8_t oldAES[AES_KEY_SIZE], oldMAC[MAC_KEY_SIZE], oldSalt[SALT_SIZE];
  memcpy(oldAES, encryptionKey, AES_KEY_SIZE);
  memcpy(oldMAC, macKey, MAC_KEY_SIZE);
  memcpy(oldSalt, activeSalt, SALT_SIZE);

  memcpy(encryptionKey, newAES, AES_KEY_SIZE);
  memcpy(macKey, newMAC, MAC_KEY_SIZE);

  if (!saveVaultWithSalt(newSalt)) {
    memcpy(encryptionKey, oldAES, AES_KEY_SIZE);
    memcpy(macKey, oldMAC, MAC_KEY_SIZE);
    memcpy(activeSalt, oldSalt, SALT_SIZE);
    memset(newSalt, 0, sizeof(newSalt));
    memset(newAES, 0, sizeof(newAES));
    memset(newMAC, 0, sizeof(newMAC));
    return false;
  }
  memcpy(activeSalt, newSalt, SALT_SIZE);
  memset(oldAES, 0, sizeof(oldAES));
  memset(oldMAC, 0, sizeof(oldMAC));
  memset(oldSalt, 0, sizeof(oldSalt));
  memset(newAES, 0, sizeof(newAES));
  memset(newMAC, 0, sizeof(newMAC));
  memset(newSalt, 0, sizeof(newSalt));
  return true;
}

