uint32_t secureRandom() { return esp_random(); }

void randomBytes(uint8_t* dst, size_t len) {
  for (size_t i = 0; i < len; i += 4) {
    uint32_t r = secureRandom();
    for (int j = 0; j < 4 && i + j < len; j++)
      dst[i + j] = (r >> (j * 8)) & 0xFF;
  }
}

String randomHexToken(size_t bytes) {
  if (bytes > SESSION_BYTES) bytes = SESSION_BYTES;
  uint8_t buf[SESSION_BYTES];
  randomBytes(buf, bytes);
  const char* hex = "0123456789abcdef";
  String out;
  out.reserve(bytes * 2);
  for (size_t i = 0; i < bytes; i++) {
    out += hex[(buf[i] >> 4) & 0xF];
    out += hex[buf[i] & 0xF];
  }
  memset(buf, 0, sizeof(buf));
  return out;
}

String generateApPassword() {
  const char* chars =
    "abcdefghjkmnpqrstuvwxyz"
    "ABCDEFGHJKMNPQRSTUVWXYZ"
    "23456789";
  const size_t n = strlen(chars);
  String result;
  for (int i = 0; i < 10; i++) result += chars[secureRandom() % n];
  return result;
}

// ============================================================
// CONSTANT TIME
// ============================================================

bool constantTimeEquals(const uint8_t* a, const uint8_t* b, size_t len) {
  uint8_t diff = 0;
  for (size_t i = 0; i < len; i++) diff |= a[i] ^ b[i];
  return diff == 0;
}

bool constantTimeEquals(const String &a, const String &b) {
  if (a.length() != b.length()) return false;
  uint8_t diff = 0;
  for (size_t i = 0; i < a.length(); i++)
    diff |= (uint8_t)a[i] ^ (uint8_t)b[i];
  return diff == 0;
}

// ============================================================
// KDF
// ============================================================

bool deriveKeys(const char* password, size_t pwLen,
                const uint8_t* salt,
                uint8_t* aesOut, uint8_t* macOut) {
  const mbedtls_md_info_t* md =
    mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
  if (!md) return false;

  uint8_t derived[DERIVED_KEY_SIZE];
  memset(derived, 0, sizeof(derived));

  int rc = mbedtls_pkcs5_pbkdf2_hmac_ext(
      MBEDTLS_MD_SHA256,
      (const unsigned char*)password, pwLen,
      salt, SALT_SIZE,
      PBKDF2_ITERATIONS,
      DERIVED_KEY_SIZE,
      derived);

  if (rc != 0) { memset(derived, 0, sizeof(derived)); return false; }

  memcpy(aesOut, derived, AES_KEY_SIZE);
  memcpy(macOut, derived + AES_KEY_SIZE, MAC_KEY_SIZE);
  memset(derived, 0, sizeof(derived));
  return true;
}

bool deriveKeys(const String& password,
                const uint8_t* salt,
                uint8_t* aesOut, uint8_t* macOut) {
  return deriveKeys(password.c_str(), password.length(),
                    salt, aesOut, macOut);
}

// ============================================================
// HMAC
// ============================================================

bool hmacSha256(const uint8_t* key, size_t keyLen,
                const uint8_t* data, size_t dataLen,
                uint8_t* output) {
  const mbedtls_md_info_t* md =
    mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
  if (!md) return false;
  return mbedtls_md_hmac(md, key, keyLen, data, dataLen, output) == 0;
}

// ============================================================
// AES CBC
// ============================================================

bool aesEncrypt(const uint8_t* input, uint8_t* output, size_t len,
                const uint8_t* key, const uint8_t* iv) {
  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);
  if (mbedtls_aes_setkey_enc(&aes, key, 256) != 0) {
    mbedtls_aes_free(&aes); return false;
  }
  uint8_t ivLocal[16];
  memcpy(ivLocal, iv, 16);
  int rc = mbedtls_aes_crypt_cbc(&aes, MBEDTLS_AES_ENCRYPT,
                                 len, ivLocal, input, output);
  memset(ivLocal, 0, sizeof(ivLocal));
  mbedtls_aes_free(&aes);
  return rc == 0;
}

bool aesDecrypt(const uint8_t* input, uint8_t* output, size_t len,
                const uint8_t* key, const uint8_t* iv) {
  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);
  if (mbedtls_aes_setkey_dec(&aes, key, 256) != 0) {
    mbedtls_aes_free(&aes); return false;
  }
  uint8_t ivLocal[16];
  memcpy(ivLocal, iv, 16);
  int rc = mbedtls_aes_crypt_cbc(&aes, MBEDTLS_AES_DECRYPT,
                                 len, ivLocal, input, output);
  memset(ivLocal, 0, sizeof(ivLocal));
  mbedtls_aes_free(&aes);
  return rc == 0;
}

// ============================================================
// PKCS7
// ============================================================

size_t paddedSize(size_t len) { return len + (16 - (len % 16)); }

bool addPadding(const uint8_t* input, size_t len,
                uint8_t* output, size_t outputLen) {
  size_t pad = 16 - (len % 16);
  if (outputLen < len + pad) return false;
  memcpy(output, input, len);
  for (size_t i = len; i < len + pad; i++) output[i] = pad;
  return true;
}

bool removePadding(uint8_t* data, size_t &len) {
  if (len == 0 || len % 16 != 0) return false;
  uint8_t pad = data[len - 1];
  if (pad == 0 || pad > 16) return false;
  uint8_t diff = 0;
  for (size_t i = 0; i < pad; i++) diff |= data[len - 1 - i] ^ pad;
  if (diff != 0) return false;
  len -= pad;
  return true;
}

// ============================================================
// CONFIG
// ============================================================

bool saveConfig() {
  File f = LittleFS.open(CONFIG_TMP, FILE_WRITE);
  if (!f) return false;
  size_t written = f.write((const uint8_t*)&config, sizeof(config));
  f.flush(); f.close();
  if (written != sizeof(config)) {
    LittleFS.remove(CONFIG_TMP); return false;
  }
  LittleFS.remove(CONFIG_FILE);
  if (!LittleFS.rename(CONFIG_TMP, CONFIG_FILE)) {
    LittleFS.remove(CONFIG_TMP); return false;
  }
  return true;
}

bool loadConfig() {
  if (!LittleFS.exists(CONFIG_FILE)) return false;
  File f = LittleFS.open(CONFIG_FILE, FILE_READ);
  if (!f) return false;
  size_t got = f.read((uint8_t*)&config, sizeof(config));
  f.close();
  if (got != sizeof(config)) return false;
  if (config.magic != CONFIG_MAGIC) return false;
  if (config.version != CONFIG_VERSION) return false;
  return true;
}

// ============================================================
// MAC OVER VAULT FILE
// ============================================================

bool calculateVaultMac(const VaultHeader& header,
                       const uint8_t* ciphertext,
                       size_t cipherLen, uint8_t* mac) {
  size_t headerSize = sizeof(VaultHeader);
  size_t total = headerSize + cipherLen;
  uint8_t* data = (uint8_t*)malloc(total);
  if (!data) return false;
  memcpy(data, &header, headerSize);
  memcpy(data + headerSize, ciphertext, cipherLen);
  bool ok = hmacSha256(macKey, MAC_KEY_SIZE, data, total, mac);
  memset(data, 0, total);
  free(data);
  return ok;
}

// ============================================================
// SAVE VAULT
// ============================================================

bool saveVaultWithSalt(const uint8_t* salt) {
  VaultHeader header;
  header.magic = VAULT_MAGIC;
  header.version = VAULT_VERSION;
  memcpy(header.salt, salt, SALT_SIZE);
  randomBytes(header.iv, IV_SIZE);

  size_t plainLen = sizeof(VaultData);
  size_t cipherLen = paddedSize(plainLen);
  header.dataLen = cipherLen;

  uint8_t* plain = (uint8_t*)malloc(cipherLen);
  uint8_t* encrypted = (uint8_t*)malloc(cipherLen);
  if (!plain || !encrypted) {
    if (plain) free(plain);
    if (encrypted) free(encrypted);
    return false;
  }

  if (!addPadding((uint8_t*)&vault, plainLen, plain, cipherLen)) {
    memset(plain, 0, cipherLen); memset(encrypted, 0, cipherLen);
    free(plain); free(encrypted); return false;
  }
  if (!aesEncrypt(plain, encrypted, cipherLen, encryptionKey, header.iv)) {
    memset(plain, 0, cipherLen); memset(encrypted, 0, cipherLen);
    free(plain); free(encrypted); return false;
  }

  uint8_t mac[MAC_SIZE];
  if (!calculateVaultMac(header, encrypted, cipherLen, mac)) {
    memset(plain, 0, cipherLen); memset(encrypted, 0, cipherLen);
    free(plain); free(encrypted); return false;
  }

  File f = LittleFS.open(VAULT_TMP, FILE_WRITE);
  if (!f) {
    memset(plain, 0, cipherLen); memset(encrypted, 0, cipherLen);
    free(plain); free(encrypted); return false;
  }

  bool ok = true;
  if (f.write((const uint8_t*)&header, sizeof(header)) != sizeof(header)) ok = false;
  if (ok && f.write(encrypted, cipherLen) != cipherLen) ok = false;
  if (ok && f.write(mac, MAC_SIZE) != MAC_SIZE) ok = false;
  f.flush(); f.close();

  if (!ok) {
    LittleFS.remove(VAULT_TMP);
  } else {
    LittleFS.remove(VAULT_FILE);
    if (!LittleFS.rename(VAULT_TMP, VAULT_FILE)) {
      LittleFS.remove(VAULT_TMP); ok = false;
    }
  }

  memset(plain, 0, cipherLen);
  memset(encrypted, 0, cipherLen);
  memset(mac, 0, sizeof(mac));
  free(plain); free(encrypted);
  return ok;
}

bool saveCurrentVault() { return saveVaultWithSalt(activeSalt); }

// ============================================================
// LOAD VAULT
// ============================================================

bool loadVaultWithPassword(const char* pw, size_t pwLen,
                           uint8_t* outSalt,
                           uint8_t* outAES, uint8_t* outMAC,
                           VaultData* outVault) {
  if (!LittleFS.exists(VAULT_FILE)) return false;
  File f = LittleFS.open(VAULT_FILE, FILE_READ);
  if (!f) return false;

  VaultHeader header;
  if (f.read((uint8_t*)&header, sizeof(header)) != sizeof(header)) {
    f.close(); return false;
  }
  if (header.magic != VAULT_MAGIC ||
      header.version != VAULT_VERSION ||
      header.dataLen == 0 || header.dataLen > 65536 ||
      header.dataLen % 16 != 0) {
    f.close(); return false;
  }

  uint8_t* encrypted = (uint8_t*)malloc(header.dataLen);
  uint8_t* plain     = (uint8_t*)malloc(header.dataLen);
  if (!encrypted || !plain) {
    if (encrypted) free(encrypted);
    if (plain) free(plain);
    f.close(); return false;
  }

  if (f.read(encrypted, header.dataLen) != header.dataLen) {
    free(encrypted); free(plain); f.close(); return false;
  }
  uint8_t storedMac[MAC_SIZE];
  if (f.read(storedMac, MAC_SIZE) != MAC_SIZE) {
    free(encrypted); free(plain); f.close(); return false;
  }
  f.close();

  uint8_t derived[AES_KEY_SIZE + MAC_KEY_SIZE];
  if (!deriveKeys(pw, pwLen, header.salt, derived, derived + AES_KEY_SIZE)) {
    free(encrypted); free(plain); return false;
  }

  uint8_t savedMacKey[MAC_KEY_SIZE];
  memcpy(savedMacKey, macKey, MAC_KEY_SIZE);
  memcpy(macKey, derived + AES_KEY_SIZE, MAC_KEY_SIZE);

  uint8_t calculatedMac[MAC_SIZE];
  bool macOk = calculateVaultMac(header, encrypted, header.dataLen, calculatedMac);

  if (!macOk || !constantTimeEquals(calculatedMac, storedMac, MAC_SIZE)) {
    memcpy(macKey, savedMacKey, MAC_KEY_SIZE);
    memset(savedMacKey, 0, sizeof(savedMacKey));
    memset(derived, 0, sizeof(derived));
    memset(calculatedMac, 0, sizeof(calculatedMac));
    free(encrypted); free(plain);
    return false;
  }

  memcpy(encryptionKey, derived, AES_KEY_SIZE);
  memcpy(macKey, derived + AES_KEY_SIZE, MAC_KEY_SIZE);

  bool decOk = aesDecrypt(encrypted, plain, header.dataLen,
                          encryptionKey, header.iv);

  memset(savedMacKey, 0, sizeof(savedMacKey));
  memset(derived, 0, sizeof(derived));
  memset(calculatedMac, 0, sizeof(calculatedMac));

  if (!decOk) { free(encrypted); free(plain); return false; }

  size_t plainLen = header.dataLen;
  if (!removePadding(plain, plainLen)) { free(encrypted); free(plain); return false; }
  if (plainLen != sizeof(VaultData)) { free(encrypted); free(plain); return false; }

  memcpy(outVault, plain, sizeof(VaultData));
  memcpy(outSalt, header.salt, SALT_SIZE);
  memcpy(outAES, derived, AES_KEY_SIZE);
  memcpy(outMAC, derived + AES_KEY_SIZE, MAC_KEY_SIZE);

  memset(plain, 0, header.dataLen);
  memset(encrypted, 0, header.dataLen);
  free(encrypted); free(plain);

  if (outVault->magic != VAULT_MAGIC ||
      outVault->version != VAULT_VERSION ||
      outVault->count > MAX_RECORDS)
    return false;

  return true;
}

