void buildSearchResults() {
  searchCount = 0;
  char q[MAX_EDITOR + 1];
  strlcpy(q, searchBuffer, sizeof(q));
  for (char* p = q; *p; p++) *p = tolower(*p);

  for (int i = 0; i < vault.count && searchCount < MAX_RECORDS; i++) {
    char n[MAX_NAME], u[MAX_USER];
    strlcpy(n, vault.records[i].name, sizeof(n));
    strlcpy(u, vault.records[i].username, sizeof(u));
    for (char* p = n; *p; p++) *p = tolower(*p);
    for (char* p = u; *p; p++) *p = tolower(*p);

    if (strlen(q) == 0 || strstr(n, q) || strstr(u, q))
      searchResults[searchCount++] = i;
  }
  selectedRecord = 0;
}

