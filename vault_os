// ============================================================

void webLock() {
  if (!checkSession()) { redirectTo("/"); return; }
  if (!checkCSRF()) return;

  // Send redirect first, then lock.
  clearSessionCookie();
  redirectTo("/");

  // Small delay ensures WebServer flushes the response.
  delay(50);
  lockVault();
}

